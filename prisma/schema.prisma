generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventSource {
  TICKETMASTER
  VISIT_JALISCO
  SUPERBOLETOS
  C3_STAGE
  FORO_INDEPENDENCIA
  FUNTICKET
  ARENA_GUADALAJARA
  ETICKET
  KINGTICKET
  VIBRA_JALISCO
  FEVER
  DISCOVERED
}

enum AdmissionType {
  FREE
  PAID
  UNKNOWN
}

enum EventCandidateStatus {
  PENDING
  REJECTED
  IMPORTED
}

enum EventObservationType {
  SOURCE_CREATED
  SOURCE_UPDATED
  SOURCE_DUPLICATE
  CANDIDATE_CREATED
  CANDIDATE_UPDATED
  CANDIDATE_REJECTED_DUPLICATE
  CANDIDATE_IMPORTED
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  city      String
  createdAt DateTime @default(now())
  events    Event[]

  @@unique([name, city])
  @@index([city])
}

model Artist {
  id            String               @id @default(cuid())
  name          String               @unique
  imageUrl      String?
  createdAt     DateTime             @default(now())
  events        EventArtist[]
  subscriptions ArtistSubscription[]
}

model Event {
  id                 String             @id @default(cuid())
  externalId         String
  title              String
  description        String?
  eventDate          DateTime
  imageUrl           String?
  source             EventSource
  sourceUrl          String?
  admissionType      AdmissionType      @default(UNKNOWN)
  priceMin           Decimal?           @db.Decimal(10, 2)
  priceMax           Decimal?           @db.Decimal(10, 2)
  currency           String?
  availabilityStatus String?
  lastObservedAt     DateTime?
  venueId            String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  venue              Venue              @relation(fields: [venueId], references: [id])
  artists            EventArtist[]
  likes              EventLike[]
  observations       EventObservation[]

  @@unique([source, externalId])
  @@index([eventDate])
  @@index([venueId])
  @@index([source])
  @@index([admissionType])
  @@index([lastObservedAt])
}

model EventCandidate {
  id              String               @id @default(cuid())
  title           String
  artistName      String?
  description     String?
  eventDate       DateTime?
  imageUrl        String?
  sourceUrl       String
  sourceName      String?
  venueName       String?
  city            String?
  admissionType   AdmissionType        @default(UNKNOWN)
  priceMin        Decimal?             @db.Decimal(10, 2)
  priceMax        Decimal?             @db.Decimal(10, 2)
  currency        String?
  confidence      Int                  @default(0)
  status          EventCandidateStatus @default(PENDING)
  rawText         String?
  importedEventId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  reviewedAt      DateTime?
  observations    EventObservation[]

  @@unique([sourceUrl, title])
  @@index([status])
  @@index([createdAt])
  @@index([eventDate])
}

model EventObservation {
  id                 String               @id @default(cuid())
  eventId            String?
  candidateId        String?
  source             EventSource
  type               EventObservationType
  title              String?
  artistName         String?
  venueName          String?
  city               String?
  eventDate          DateTime?
  sourceUrl          String?
  priceMin           Decimal?             @db.Decimal(10, 2)
  priceMax           Decimal?             @db.Decimal(10, 2)
  currency           String?
  availabilityStatus String?
  confidence         Int?
  metadata           Json?
  createdAt          DateTime             @default(now())
  event              Event?               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  candidate          EventCandidate?      @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([candidateId])
  @@index([source])
  @@index([type])
  @@index([createdAt])
  @@index([eventDate])
}

model EventLike {
  id          String   @id @default(cuid())
  eventId     String
  visitorHash String
  createdAt   DateTime @default(now())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, visitorHash])
  @@index([eventId])
  @@index([createdAt])
}

model EventArtist {
  eventId  String
  artistId String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([eventId, artistId])
  @@index([artistId])
}

model ArtistSubscription {
  id        String   @id @default(cuid())
  artistId  String
  email     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, email])
  @@index([artistId])
  @@index([email])
  @@index([active])
}
